{
  "name": "@stylex-variants/core",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Typed, compile-time style variants for StyleX.",
  "keywords": [
    "babel",
    "stylex",
    "typescript",
    "variants"
  ],
  "homepage": "https://github.com/corvallo/stylex-variants#readme",
  "bugs": {
    "url": "https://github.com/corvallo/stylex-variants/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corvallo/stylex-variants.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./babel": {
      "types": "./dist/babel/index.d.ts",
      "import": "./dist/babel.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b && vite build && tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "tsc -b && vitest run",
    "check-types": "tsc -b",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@babel/core": "^8.0.6"
  }
}
